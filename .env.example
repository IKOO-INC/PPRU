# Example environment settings for the PPRU portal.
# Copy values into your local shell or deployment settings; the app does not load .env automatically.
# Never commit a real .env file. Replace every placeholder before production use.

# Security: set both to strong, unique values in production.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Cloudinary: required only for admin image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MongoDB Atlas: required for persistent admin writes on Vercel.
# Leave blank for local development to keep using JSON files.
MONGODB_URI=
# Optional; these defaults are used if omitted.
MONGODB_DATABASE=ppru
MONGODB_COLLECTION=portal_data
MONGODB_NAMESPACE=ppru

# VERCEL and VERCEL_ENV are supplied automatically by Vercel; do not add them here.
