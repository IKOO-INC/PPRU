# Copy these names into your deployment's environment/secret settings.
# Do not commit a real .env file or paste CLOUDINARY_API_SECRET into source code.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# For durable admin data on Vercel, attach an Upstash Redis REST database.
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=your-kv-rest-token
